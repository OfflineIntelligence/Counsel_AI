#####################################################
# Offline Counsel AI — configuration (SINGLE SOURCE OF TRUTH)
#
# This is the ONLY .env in the project. It is used in development AND it is
# the file the installer ships: tauri.conf.json maps it to resources/.env
# inside the installed app (there used to be a separate production.env; it was
# merged into this file and deleted).
#
# THE RULE THAT MAKES ONE FILE SAFE TO SHIP:
#   Everything hardware-dependent is "auto", so the backend derives it from the
#   actual machine (GPU VRAM, RAM, CPU cores, the model's own GGUF header).
#   Machine-specific development overrides (MODEL_PATH, LLAMA_BIN, MMPROJ_PATH,
#   credentials) stay COMMENTED OUT. Uncomment one locally if you need it, but
#   never commit it uncommented — a developer's pinned CTX_SIZE or model path
#   would then override the RAM/VRAM safety detection on every user install.
#
# Load order (config.rs::from_env, first hit wins):
#   1. <exe dir>/.env            production: next to the installed executable
#   2. <exe dir>/resources/.env  production: Tauri v2 bundle location
#   3. <project root>/.env       development: this file, via target/release/../..
#   4. current working directory
#####################################################

#####################################################
# Hardware-derived settings — ALWAYS "auto"
#
# GPU_LAYERS=auto    per-model dynamic offload: the model's real layer count and
#                    size are read from its GGUF header and as many layers as fit
#                    in measured VRAM (minus KV cache) go to the GPU; the rest
#                    runs on CPU. Small models fully offload.
# CTX_SIZE=auto      the model's own GGUF context_length is the authority,
#                    bounded by available RAM and a 32768 ceiling. A pinned
#                    number here is treated as a REQUEST and is still clamped
#                    down to what the model was trained on.
# BATCH_SIZE=auto    the batch flags are OMITTED so llama-server uses its
#                    upstream-tuned defaults (n_batch 2048 / n_ubatch 512).
#                    Set a number only to deliberately constrain memory.
# THREADS=auto       conservative core count for token generation.
# THREADS_BATCH=auto ALL logical cores for prompt processing (prefill is
#                    compute-bound; more threads = faster time-to-first-token).
#####################################################
GPU_LAYERS=auto
CTX_SIZE=auto
BATCH_SIZE=auto
THREADS=auto
THREADS_BATCH=auto

# KV-cache chunk reuse (--cache-reuse): minimum chunk size llama-server may
# reuse via KV shifting when a later prompt overlaps a cached one. Cuts
# time-to-first-token on follow-up turns without quality impact. 0 disables.
CACHE_REUSE=256

# ── Storage budget ───────────────────────────────────────────────────────────
# Ceiling, in megabytes, for everything this app keeps under its app-data
# directory: models, engines, the database, the Local Storage vault, drafts,
# downloads and any KV-cache blobs.
#
# This is the SHIPPED DEFAULT. Whatever the user picks in Settings > Storage is
# stored in the database and takes precedence over this value; this is only
# consulted when the user has never chosen one (or reset theirs).
#
# 0 = unlimited (eviction never runs).
#
# When usage exceeds the budget, eviction runs in tiers: KV-cache blobs and
# rendered page images first, then interrupted downloads, then non-active models
# least-recently-used first, then superseded draft versions. The inference
# engine, the database, the active model, the user's Local Storage documents and
# the current version of every draft are NEVER deleted automatically — if the
# budget cannot be met without them, the shortfall is reported instead.
APP_DISK_LIMIT_MB=20480

# Advanced llama-server tuning: whitespace-separated flags appended verbatim to
# the llama-server command line. Empty by default. Examples:
#   --mlock                                   keep model locked in RAM
#   --cache-type-k q8_0 --cache-type-v q8_0   halve KV-cache memory (needs flash-attn)
#   --device Vulkan1 --main-gpu 0             pin a specific GPU on multi-GPU laptops
# LLAMA_EXTRA_ARGS=

#####################################################
# Network Configuration
#
# API_PORT   the backend's own HTTP server. Bound EXCLUSIVELY — there is no
#            random-port fallback — and reported to the frontend over Tauri IPC
#            (get_backend_port). Changing it here is sufficient; the frontend
#            reads the real bound port at runtime.
# LLAMA_PORT the llama-server child process. Internal to the backend.
#####################################################
API_HOST=127.0.0.1
API_PORT=8888
LLAMA_HOST=127.0.0.1
LLAMA_PORT=9639

#####################################################
# Performance & Timeout Settings
#
# NOTE, verified against the code: of the keys in this section only
# MAX_CONCURRENT_STREAMS reaches anything, and only to size a thread-pool field.
# HOT_SWAP_GRACE_SECONDS, HEALTH_TIMEOUT_SECONDS, HEALTH_CHECK_TIMEOUT_SECONDS,
# GENERATE_TIMEOUT_SECONDS and STREAM_TIMEOUT_SECONDS are parsed into Config and
# never read by any consumer. The timeouts actually in force are hardcoded
# (axum TimeoutLayer 600s, reqwest clients 600s, llama-server health wait 120s,
# Tauri health poll 180s). They are kept here so no setting is lost in the
# merge; removing them is a separate, deliberate change.
#####################################################
MAX_CONCURRENT_STREAMS=2
HOT_SWAP_GRACE_SECONDS=25
HEALTH_TIMEOUT_SECONDS=600
HEALTH_CHECK_TIMEOUT_SECONDS=900
GENERATE_TIMEOUT_SECONDS=300
STREAM_TIMEOUT_SECONDS=600

#####################################################
# Monitoring & Logging
#
# PROMETHEUS_PORT is parsed but nothing binds it — /metrics is served on
# API_PORT by the main router. REQUESTS_PER_SECOND is parsed and never read
# (there is no rate limiter). Both kept so the merge loses nothing.
#####################################################
PROMETHEUS_PORT=9000
REQUESTS_PER_SECOND=24
RUST_LOG=info
# Verbose per-target form, equivalent to the above; uncomment to be explicit,
# or raise a target (e.g. offline_intelligence=debug) while diagnosing.
# RUST_LOG=info,axum=info,tower_http=info
# Inference-server output (model load, device selection, per-request timings)
# is logged under the "inference_server" target at info level.

#####################################################
# Vision / multimodal
#
# MMPROJ_PATH pairs a multimodal projector (--mmproj) with the MODEL_PATH model
# below — a DEVELOPMENT override only, mirroring the MODEL_PATH / LLAMA_BIN
# pattern. Unset, empty, or the literal "none" all mean "no override", which is
# the correct production value: installed vision models resolve their projector
# automatically from the model registry at activation time, because a projector
# belongs to a specific model rather than to static config.
# A set-but-missing path is a loud warning and is IGNORED, never a broken spawn.
#####################################################
MMPROJ_PATH=none
# MMPROJ_PATH="F:/models/mmproj-Qwen2.5-VL-3B-Instruct-f16.gguf"

# Carried over from the former production.env so nothing is lost in the merge.
# Both are read by NOTHING in the codebase (verified: zero references). Vision
# is enabled by the presence of a projector, not by a flag.
ENABLE_MULTIMODAL=false
USE_CLIP=false

#####################################################
# Development-only overrides — LEAVE COMMENTED
#
# These are machine-specific. An uncommented value here ships to every user.
#####################################################
# MODEL_PATH: a specific model file. Unset in production — models are installed
# through the Models panel and the last-used one is auto-loaded at startup.
# MODEL_PATH="F:/OfflineChat_Law/crates/offline-intelligence/Resources/models/gguf-model.gguf"

# LLAMA_BIN: a specific llama-server binary. Unset in production — the engine is
# placed by the installer and resolved from the engine registry's metadata.json.
# LLAMA_BIN="F:/OfflineChat_Law/crates/offline-intelligence/Resources/bin/Windows/llama-b8037-bin-win-cuda-12.4-x64/llama-server.exe"

#####################################################
# Optional credentials — LEAVE COMMENTED
#####################################################
# HF_TOKEN: required only for downloading gated/private models from HuggingFace.
# The app's normal path is the Settings > API keys panel, which stores the token
# encrypted in the database; this env var is a development convenience.
# Get one from: https://huggingface.co/settings/tokens
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OPENROUTER_API_KEY: read by nothing. OpenRouter support was removed (the model
# registry actively deletes openrouter entries). Kept only so the merge loses
# no key; safe to delete.
# OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# SMTP: used by the feedback and login-notification endpoints. Non-functional in
# offline mode and shipped with no credentials, so feedback is stored locally
# and never sent. Do not put real credentials in a file that ships to users.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
