<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Allow JIT compilation for llama.cpp runtime optimization -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>

    <!-- Allow unsigned executable memory for dynamic code generation (required for ML inference) -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>

    <!-- Enable outgoing network connections for model downloads and API calls -->
    <key>com.apple.security.network.client</key>
    <true/>

    <!-- Allow reading and writing user-selected files (model files, exports, logs) -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>

    <!-- Allow reading and writing to application support directory -->
    <key>com.apple.security.files.downloads.read-write</key>
    <true/>
</dict>
</plist>
